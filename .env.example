# Copy this file to .env and fill in your values.
# NEVER commit .env to version control — it is listed in .gitignore.

# ── Supabase (required for production deployment) ──────────────────────────────
# Only the anon (public) key goes here. NEVER put the service role key in frontend code.
# If either variable is missing or empty, the app falls back to localStorage demo mode.
# Demo mode is NOT secure and NOT suitable for production — data is browser-local only.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── App config ─────────────────────────────────────────────────────────────────
VITE_APP_NAME=Star Progress

# ── Email verification redirect URL ────────────────────────────────────────────
# Set this to your deployed app URL (no trailing slash) so email verification
# links point to the correct domain.
# Example for GitHub Pages: https://YOUR_USERNAME.github.io/StarProgress
# Leave empty for local-only development (falls back to http://localhost:5173).
VITE_APP_URL=
